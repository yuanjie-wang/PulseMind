# Playwright Chromium browser (bundled for distribution)
browsers/

# Dependencies
node_modules/

# Build outputs
dist/
out/
release/

# CI build artifacts downloaded to the repo root for local inspection
# (2026-11-15, ~1.7GB across linux-/mac-arm64-/mac-x64-/win-* subdirs) —
# never part of the repo; `git add -A` must not stage them (review_20261117 中3).
/dist-artifacts/

# OS / system
.DS_Store
*.tsbuildinfo

# Tool caches
.codegraph/
.ccweb/
.claude/

# Docs / release assets
readme30.pdf

# Local working files
.workbuddy/
resources/chromium/
# sherpa-onnx 引擎（PLAN-voice-input §3.2，prepare-asr-engine.js 生成，同
# resources/chromium 纪律：CI/dev 由脚本产出，不进 git）
resources/asr-engine/
# 例外，别顺手加进上面那条：resources/cxx-runtime/ 是**提交物**（私有
# libstdc++ 副本，1.7MB）。它不能现场生成——prepare-asr-engine.js 要先校验它的
# sha256 才开始拷贝，缺了就是硬失败。原因与制作步骤见该目录的 README.md。
# 两行是 git 的标准写法：父目录被排除时，子文件的 ! 规则不生效，必须先放目录。
!resources/cxx-runtime/
!resources/cxx-runtime/**

# Ad-hoc debug scratch under scripts/ (throwaway probe/dump snippets)
scripts/.tmp/

# Local working dirs — _task / _product / _review and any future underscore
# prefix at the repo root. Anchored (leading "/") on purpose: a nested
# `_something/` inside src/ is not covered and would still be tracked.
/_*/

# Local agent workspace state
.zcode/

# Local test artifacts — a full project copy (32MB) and a generated PDF left
# behind by manual export/deck testing; never part of the repo.
/test/
/test.pdf

# Vitest coverage report output (`npm run test:coverage`)
coverage/

# Runtime data a stray app instance wrote at the repo root (plans/, tmp/) —
# the real runtime dir is ~/.pulsemind/; anything landing here is local debris.
/.pulsemind/
