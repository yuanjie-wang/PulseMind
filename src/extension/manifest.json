{
  "manifest_version": 3,
  "name": "PulseMind Agent",
  "version": "0.2.0",
  "description": "Use your PulseMind agent on any web page.",
  "permissions": ["storage", "tabs", "alarms", "debugger"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
