# Playwright Chromium browser (bundled for distribution)
browsers/

# Dependencies
node_modules/

# Build outputs
dist/
out/
release/

# OS / system
.DS_Store
*.tsbuildinfo

# Tool caches
.codegraph/
.ccweb/
.claude/

# Docs / release assets
readme30.pdf

# Local working files
.workbuddy/
resources/chromium/

# Ad-hoc debug scratch under scripts/ (throwaway probe/dump snippets)
scripts/.tmp/

# Local working dirs — _task / _product / _review and any future underscore
# prefix at the repo root. Anchored (leading "/") on purpose: a nested
# `_something/` inside src/ is not covered and would still be tracked.
/_*/

# Local agent workspace state
.zcode/

# Local test artifacts — a full project copy (32MB) and a generated PDF left
# behind by manual export/deck testing; never part of the repo.
/test/
/test.pdf

# Vitest coverage report output (`npm run test:coverage`)
coverage/

# Runtime data a stray app instance wrote at the repo root (plans/, tmp/) —
# the real runtime dir is ~/.pulsemind/; anything landing here is local debris.
/.pulsemind/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
