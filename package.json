{
  "name": "pulsemind",
  "version": "0.4.2",
  "description": "PulseMind Desktop AI Chat Application",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/build.js && concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "node scripts/dev-renderer.js",
    "dev:electron": "wait-on http://localhost:5173 && cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .",
    "build": "node scripts/build.js && vite build && node scripts/ensure-chromium.js && node scripts/build-extension.js",
    "build:extension": "node scripts/build-extension.js",
    "lint": "eslint src/ tests/ scripts/",
    "lint:fix": "eslint src/ tests/ scripts/ --fix",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "pretest": "tsc -b",
    "test": "vitest run",
    "browsers:install": "playwright-core install chromium",
    "browsers:ensure": "node scripts/ensure-chromium.js",
    "build:picker": "node scripts/build-preview-picker.mjs",
    "deps:check": "node scripts/check-deps.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.9.0",
    "cron-parser": "^4.9.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "markitdown-js": "^0.0.14",
    "parse5": "^7.3.0",
    "playwright-core": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.3",
    "turndown": "^7.2.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.5.0",
    "@ant-design/x": "^2.6.0",
    "@ant-design/x-markdown": "^2.5.0",
    "@ant-design/x-sdk": "^2.8.0",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.39.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/chrome": "^0.2.9",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^6.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.20",
    "docx-preview": "^0.4.0",
    "echarts": "^6.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.13",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^4.10.38",
    "prettier": "^3.9.5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-syntax-highlighter": "^16.1.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.3",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.pulsemind.app",
    "productName": "PulseMind",
    "copyright": "Copyright © 2026 PulseMind",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/@img/**/*"
    ],
    "icon": "resources/pulseMind.png",
    "compression": "maximum",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/splash",
        "to": "resources/splash",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/pulseMind-win.ico",
        "to": "resources/pulseMind-win.ico"
      },
      {
        "from": "resources/pulseMind-win.png",
        "to": "resources/pulseMind-win.png"
      },
      {
        "from": "resources/pulseMind.icns",
        "to": "resources/pulseMind.icns"
      },
      {
        "from": "resources/pulseMind.png",
        "to": "resources/pulseMind.png"
      },
      {
        "from": "resources/pulseMind_tray.png",
        "to": "resources/pulseMind_tray.png"
      },
      {
        "from": "resources/pulseMind_tray@2x.png",
        "to": "resources/pulseMind_tray@2x.png"
      },
      {
        "from": "templates",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/chromium",
        "to": "chromium",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "out/extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "resources/pulseMind.icns",
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "resources/pulseMind-win.ico",
      "target": "portable"
    },
    "linux": {
      "icon": "resources/pulseMind.png",
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Development"
    },
    "afterPack": "scripts/strip-lproj.js",
    "directories": {
      "buildResources": "resources"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
