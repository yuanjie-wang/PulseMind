{
  "name": "pulsemind",
  "version": "0.3.4",
  "description": "PulseMind Desktop AI Chat Application",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/build.js && concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "node scripts/dev-renderer.js",
    "dev:electron": "wait-on http://localhost:5173 && cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .",
    "build": "node scripts/build.js && vite build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "@ant-design/x": "^2.6.0",
    "@ant-design/x-markdown": "^2.5.0",
    "@ant-design/x-sdk": "^2.8.0",
    "@mozilla/readability": "^0.6.0",
    "adm-zip": "^0.5.17",
    "antd": "^6.1.1",
    "better-sqlite3": "^12.9.0",
    "chrome-devtools-mcp": "^1.6.0",
    "echarts": "^6.1.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.24.0",
    "markitdown-js": "^0.0.14",
    "ogl": "^1.0.11",
    "sharp": "^0.35.3",
    "turndown": "^7.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.39.0",
    "@types/adm-zip": "^0.5.8",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.pulsemind.app",
    "productName": "PulseMind",
    "copyright": "Copyright © 2026 PulseMind",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/@img/**/*",
      "node_modules/chrome-devtools-mcp/**/*"
    ],
    "icon": "resources/pulseMind.png",
    "files": [
      "out/**/*"
    ],
    "extraFiles": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/adm-zip/**/*",
      "node_modules/@img/**/*",
      "node_modules/markitdown-js/**/*",
      "node_modules/jsdom/**/*",
      "node_modules/@mozilla/readability/**/*",
      "node_modules/turndown/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/splash",
        "to": "resources/splash",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/pulseMind-win.ico",
        "to": "resources/pulseMind-win.ico"
      },
      {
        "from": "resources/pulseMind-win.png",
        "to": "resources/pulseMind-win.png"
      },
      {
        "from": "resources/pulseMind.icns",
        "to": "resources/pulseMind.icns"
      },
      {
        "from": "resources/pulseMind.png",
        "to": "resources/pulseMind.png"
      },
      {
        "from": "templates",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "resources/pulseMind.icns",
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "resources/pulseMind-win.ico",
      "target": "portable"
    },
    "linux": {
      "icon": "resources/pulseMind.png",
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Development"
    },
    "afterPack": "scripts/strip-lproj.js",
    "directories": {
      "buildResources": "resources"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
